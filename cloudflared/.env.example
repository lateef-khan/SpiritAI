# Copy to cloudflared/.env with `just env` (or `just cloudflared env` from the repo root).

# Zero Trust → Networks → Tunnels → your tunnel → the install command. The token is the long
# string after --token. Anyone with it can serve traffic for your hostnames: keep it secret.
TUNNEL_TOKEN=

# The Docker network of the Chatwoot to reach. Production: spirit-chatwoot-prod_default.
# Local dev Chatwoot (`just chatwoot up`): spirit-chatwoot_default.
CHATWOOT_NETWORK=spirit-chatwoot-prod_default
