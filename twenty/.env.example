TWENTY_PORT=53001
# crm.spirit.localhost, not localhost: the Hub frames the CRM, and the session cookie reaches the
# frame only when the Hub and the CRM are the same site (both under spirit.localhost).
SERVER_URL=http://crm.spirit.localhost:53001
EMAIL_DRIVER=LOGGER
EMAIL_FROM_NAME=Spirit CRM
EMAIL_FROM_ADDRESS=crm@localhost
STORAGE_TYPE=LOCAL
TELEMETRY_ENABLED=false

# Owner row access (see apps/row-access). The server and the worker both read it. Turn it on
# only after the app is installed and its config is saved, then restart both.
SPIRIT_ROW_ACCESS_ENFORCED=false

# The Spirit Hub (the fork's spirit-hub module). Local dev values; set the hub.<domain> ones in
# production. SPIRIT_HUB_SECRET is a secret: TWENTY_SPIRIT_HUB_SECRET in secrets/<env>.env, equal to
# Spirit's Twenty__HubSecret. A TWENTY_SPIRIT_HUB_* value in secrets/<env>.env wins over these.
SPIRIT_HUB_ORIGIN=http://hub.spirit.localhost:5299
SPIRIT_HUB_LOGIN_URL=http://hub.spirit.localhost:5299/chat/login.html?app=crm
