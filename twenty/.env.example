# Copy to twenty/.env with `just env` (or `just twenty env` from the repo root), which also
# fills ENCRYPTION_KEY and REDIS_PASSWORD.
# Full list of settings: https://docs.twenty.com/developers/self-host/capabilities/setup

# Encrypts secrets in the database. Never change it after the first start; to rotate, move
# the old key to FALLBACK_ENCRYPTION_KEY first.
ENCRYPTION_KEY=
# FALLBACK_ENCRYPTION_KEY=

TWENTY_PORT=53001
# The address people open. Production: https://crm.<domain>.
SERVER_URL=http://localhost:53001

# Empty: a throwaway local postgres. Neon: the DIRECT host (no -pooler), and a database of
# its own (create database twenty;), because Twenty makes many schemas of its own.
# PG_DATABASE_URL=postgres://USER:PASS@ep-xxx.us-east-2.aws.neon.tech/twenty?sslmode=require
PG_DATABASE_URL=

# Goes in the redis URL, so use letters and digits only.
REDIS_PASSWORD=

# LOGGER prints every email (invites, password resets) to the server logs.
EMAIL_DRIVER=LOGGER
EMAIL_FROM_NAME=Spirit CRM
EMAIL_FROM_ADDRESS=crm@localhost
# Production with Resend (the password is a Resend API key; the sender domain must be verified in Resend):
# EMAIL_DRIVER=SMTP
# EMAIL_FROM_ADDRESS=crm@your-domain.com
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASSWORD=re_xxx

# Local dev keeps uploads on a throwaway volume. Production ignores this line and needs the
# STORAGE_S3_* bucket below. Backblaze B2: the endpoint and region are on the bucket page,
# and the keys are an application key with read and write on that one bucket.
STORAGE_TYPE=LOCAL
# STORAGE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# STORAGE_S3_REGION=us-west-004
# STORAGE_S3_NAME=spirit-twenty
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Do not send usage data to Twenty.
TELEMETRY_ENABLED=false
