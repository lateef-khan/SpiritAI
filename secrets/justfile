# Secrets recipes. From the repo root: `just secrets <recipe>`. See secrets/README.md.

# List the recipes.
default:
    @just --list

# Make secrets/<env>.env from example.env and fill the values that are generated. Never overwrites.
init env="dev":
    #!/usr/bin/env bash
    set -euo pipefail
    file="{{env}}.env"
    if [ -f "$file" ]; then
        echo "secrets/$file already exists; leaving it alone."
        exit 0
    fi
    umask 077
    cp example.env "$file"
    ./set.sh {{env}} Goto__WebhookSecret "$(openssl rand -hex 32)"
    ./set.sh {{env}} CHATWOOT_SECRET_KEY_BASE "$(openssl rand -hex 64)"
    ./set.sh {{env}} CHATWOOT_REDIS_PASSWORD "$(openssl rand -hex 24)"
    ./set.sh {{env}} TWENTY_ENCRYPTION_KEY "$(openssl rand -base64 32)"
    ./set.sh {{env}} TWENTY_REDIS_PASSWORD "$(openssl rand -hex 24)"
    if [ "{{env}}" = "prod" ]; then
        ./set.sh prod POSTGRES_SERVER_SUPERUSER_PASSWORD "$(openssl rand -hex 24)"
        ./set.sh prod POSTGRES_SERVER_BACKUP_CIPHER_PASS "$(openssl rand -base64 48)"
        ./set.sh prod CHATWOOT_DATABASE_URL "postgres://chatwoot:$(openssl rand -hex 24)@postgres:5432/chatwoot"
        ./set.sh prod TWENTY_PG_DATABASE_URL "postgres://twenty:$(openssl rand -hex 24)@postgres:5432/twenty"
    fi
    echo "Wrote secrets/$file. Fill in the empty values you need."

# Send Spirit's secrets in prod.env to GitHub. Then run the "Sync Fly secrets" workflow.
push:
    #!/usr/bin/env bash
    set -euo pipefail
    # The file's name on the left, the GitHub secret the workflow reads on the right.
    names=(
        OPENAI_API_KEY:OPENAI_API_KEY
        OPENCODE_GO_API_KEY:OPENCODE_GO_API_KEY
        QDRANT_API_KEY:QDRANT_API_KEY
        POSTGRES_CONNECTION_STRING:POSTGRES_CONNECTION_STRING
        CUSTSERVICE_SQL_PASSWORD:CUSTSERVICE_SQL_PASSWORD
        GRAFANA_CLOUD_INSTANCE_ID:GRAFANA_CLOUD_INSTANCE_ID
        GRAFANA_CLOUD_API_TOKEN:GRAFANA_CLOUD_API_TOKEN
        AWS_ACCESS_KEY_ID:AWS_ACCESS_KEY_ID
        AWS_SECRET_ACCESS_KEY:AWS_SECRET_ACCESS_KEY
        TS_AUTHKEY:TS_AUTHKEY
        FLY_API_TOKEN:FLY_API_TOKEN
        Chatwoot__BotToken:CHATWOOT_BOT_TOKEN
        Chatwoot__ServiceToken:CHATWOOT_SERVICE_TOKEN
        Goto__ClientId:GOTO_CLIENT_ID
        Goto__ClientSecret:GOTO_CLIENT_SECRET
        Goto__PersonalAccessToken:GOTO_PERSONAL_ACCESS_TOKEN
        Goto__AccountKey:GOTO_ACCOUNT_KEY
        Goto__WebhookSecret:GOTO_WEBHOOK_SECRET
    )
    if [ ! -f prod.env ]; then
        echo "secrets/prod.env is missing. Run: just secrets init prod" >&2
        exit 1
    fi
    for pair in "${names[@]}"; do
        key="${pair%%:*}" name="${pair#*:}"
        value="$(grep -m1 "^$key=" prod.env | cut -d= -f2- || true)"
        if [ -z "$value" ]; then
            echo "skip $name: $key is empty"
            continue
        fi
        printf '%s' "$value" | gh secret set "$name"
    done
    echo "Done. Copy them to Fly: gh workflow run sync-fly-secrets.yml"
