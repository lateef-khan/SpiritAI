# Every secret of every app, one file per environment: secrets/dev.env and secrets/prod.env.
# `just secrets init dev` (or prod) copies this file and fills the values it can generate.
# Both files are git-ignored. Keep a copy of prod.env in the password manager.
#
# Format: KEY=value on one line. No quotes, no spaces around =, no `export`. Docker Compose and
# `just spirit run` read the file as it is, so a quote would become part of the value.

# ---------------------------------------------------------------------------------------------
# SpiritAI. The names are the ones the app reads: AgentCore secrets in capitals, .NET settings
# with __ between section and key. `just spirit run` loads dev.env; `just secrets push` sends
# prod.env to GitHub, and the "Sync Fly secrets" workflow copies it to Fly.
# ---------------------------------------------------------------------------------------------

OPENAI_API_KEY=
OPENCODE_GO_API_KEY=
QDRANT_API_KEY=
# Dev: `just spirit run` points Spirit at a throwaway local database and ignores this.
POSTGRES_CONNECTION_STRING=
# The Sage login the customer-service tools use.
CUSTSERVICE_SQL_PASSWORD=
# Optional, together.
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# Prod only: the blob bucket. Dev uses the local MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prod only: joins the Fly Machine to the tailnet. Starts with tskey-auth-.
TS_AUTHKEY=
# Prod only: lets the GitHub workflows deploy to Fly.
FLY_API_TOKEN=

# Dev only. Prod has it in fly.toml.
Auth__Neon__BaseUrl=

# `just chatwoot setup` writes Chatwoot__InboxIdentifier and Chatwoot__BotToken. Fill the other three.
Chatwoot__BaseUrl=http://localhost:53000
Chatwoot__AccountId=
Chatwoot__InboxIdentifier=
Chatwoot__BotToken=
# A plain agent's access token. See chatwoot/setup/spirit-inbox.sh.
Chatwoot__ServiceToken=
# Written by `just chatwoot setup`.
Chatwoot__PlatformToken=
Chatwoot__AdminToken=
Chatwoot__InboxId=

# GoTo ring alerts. Optional, all five together. The PAT needs call-events.v1.events.read,
# call-events.v1.notifications.manage, users.v1.lines.read and identity:.
Goto__ClientId=
Goto__ClientSecret=
Goto__PersonalAccessToken=
Goto__AccountKey=
# A long random value; generated.
Goto__WebhookSecret=

# Hub settings: where the Hub is served and where its apps live. Dev only; prod has them in
# fly.toml. The ports are the local Chatwoot and Twenty (TWENTY_HOST_PORT and CHATWOOT_HOST_PORT below).
Hub__Host=
Hub__DeskUrl=http://desk.spirit.localhost:53000
Hub__CrmUrl=http://crm.spirit.localhost:53001

# Twenty fork settings: how Spirit reaches the fork's endpoints. Twenty__HubSecret must equal
# TWENTY_SPIRIT_HUB_SECRET below; `openssl rand -hex 32` makes one.
Twenty__BaseUrl=http://localhost:53001
Twenty__HubSecret=

# ---------------------------------------------------------------------------------------------
# Chatwoot. Compose passes each to the container under the name after CHATWOOT_. Secrets and
# settings alike. A setting left empty takes its local default in dev; prod has none and will not
# start until every required one is set.
# ---------------------------------------------------------------------------------------------

# Generated.
CHATWOOT_SECRET_KEY_BASE=
# Generated.
CHATWOOT_REDIS_PASSWORD=
# Chatwoot's role, password, and database on the shared server in postgres/. Dev: leave empty for
# postgres://chatwoot:chatwoot@postgres:5432/chatwoot. Prod: `just secrets init prod` generates it.
CHATWOOT_DATABASE_URL=
# Prod: the Resend API key when CHATWOOT_SMTP_* below points at Resend.
CHATWOOT_SMTP_PASSWORD=
# Prod: an application key with read and write on the one bucket.
CHATWOOT_STORAGE_ACCESS_KEY_ID=
CHATWOOT_STORAGE_SECRET_ACCESS_KEY=
# An administrator's access token (Profile settings > Access token), for `just chatwoot setup`.
CHATWOOT_ADMIN_TOKEN=

# Dev: leave empty for 53000. The port on this machine; prod has none.
CHATWOOT_HOST_PORT=
# Dev: leave empty for 58025. Where Mailpit shows the emails Chatwoot sent; prod has no Mailpit.
CHATWOOT_MAILPIT_PORT=
# Dev: leave empty for http://desk.spirit.localhost:53000. Prod required: https://desk.<domain>.
CHATWOOT_FRONTEND_URL=
# Dev: leave empty for false. Prod: the tunnel ends TLS, so false is right there too.
CHATWOOT_FORCE_SSL=
# initializers/spirit_hub.rb. Dev: leave empty for http://hub.spirit.localhost:5299. Prod
# required: https://hub.<domain>.
CHATWOOT_SPIRIT_HUB_ORIGIN=
# Dev: leave empty for http://hub.spirit.localhost:5299/chat/login.html?app=desk. Prod required:
# https://hub.<domain>/chat/login.html?app=desk.
CHATWOOT_SPIRIT_HUB_LOGIN_URL=
# Where Chatwoot sends a visitor after sign-out. Same address as the login URL above. Dev default
# and prod requirement are the same as for it.
CHATWOOT_LOGOUT_REDIRECT_LINK=
# Dev and prod default: false.
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=
# Dev and prod default: redis://redis:6379. The password is CHATWOOT_REDIS_PASSWORD.
CHATWOOT_REDIS_URL=
# Dev: leave empty for Spirit <support@localhost>. Prod required, such as Spirit <support@<domain>>.
CHATWOOT_MAILER_SENDER_EMAIL=
# Email server. Dev: leave empty to use Mailpit (mailpit, 1025, localhost, no STARTTLS). Prod
# required: the host, port, domain, and STARTTLS (true or false).
CHATWOOT_SMTP_ADDRESS=
CHATWOOT_SMTP_PORT=
CHATWOOT_SMTP_DOMAIN=
CHATWOOT_SMTP_ENABLE_STARTTLS_AUTO=
# Prod, when the server needs a login. AUTHENTICATION is the method (plain or login), not a key;
# the password is CHATWOOT_SMTP_PASSWORD above.
CHATWOOT_SMTP_USERNAME=
CHATWOOT_SMTP_AUTHENTICATION=
# Dev and prod default: false.
CHATWOOT_SAFE_FETCH_ALLOW_PRIVATE_NETWORK=
# Dev and prod default: true.
CHATWOOT_RAILS_LOG_TO_STDOUT=
# Dev and prod default: info.
CHATWOOT_LOG_LEVEL=
# Prod required: the bucket's S3 endpoint, region, and name. Dev keeps uploads on a
# local volume.
CHATWOOT_STORAGE_ENDPOINT=
CHATWOOT_STORAGE_REGION=
CHATWOOT_STORAGE_BUCKET_NAME=

# ---------------------------------------------------------------------------------------------
# Twenty CRM. Compose passes each to the container under the name after TWENTY_. Secrets and
# settings alike. A setting left empty takes its local default in dev; prod has none and will not
# start until every required one is set.
# ---------------------------------------------------------------------------------------------

# Generated. Never change it after the first start; to rotate, move the old key to
# TWENTY_FALLBACK_ENCRYPTION_KEY first.
TWENTY_ENCRYPTION_KEY=
TWENTY_FALLBACK_ENCRYPTION_KEY=
# Generated. Letters and digits only: it goes in the redis URL.
TWENTY_REDIS_PASSWORD=
# Twenty's role, password, and database on the shared server in postgres/. Dev: leave empty for
# postgres://twenty:twenty@postgres:5432/twenty. Prod: `just secrets init prod` generates it.
TWENTY_PG_DATABASE_URL=
TWENTY_EMAIL_SMTP_PASSWORD=
TWENTY_AUTH_MICROSOFT_CLIENT_SECRET=
TWENTY_STORAGE_S3_ACCESS_KEY_ID=
TWENTY_STORAGE_S3_SECRET_ACCESS_KEY=
# SPIRIT_HUB_SECRET must equal Twenty__HubSecret.
TWENTY_SPIRIT_HUB_SECRET=
# Dev: leave empty for http://hub.spirit.localhost:5299. Prod required: https://hub.<domain>.
TWENTY_SPIRIT_HUB_ORIGIN=
# Dev: leave empty for http://hub.spirit.localhost:5299/chat/login.html?app=crm. Prod required:
# https://hub.<domain>/chat/login.html?app=crm.
TWENTY_SPIRIT_HUB_LOGIN_URL=

# Dev: leave empty for 53001. The port on this machine; prod has none.
TWENTY_HOST_PORT=
# Dev: leave empty for http://crm.spirit.localhost:53001 (not localhost: the Hub frames the CRM
# and the session cookie needs both under spirit.localhost). Prod required: https://crm.<domain>.
TWENTY_SERVER_URL=
# Dev and prod default: false.
TWENTY_TELEMETRY_ENABLED=
# Owner row access (twenty/apps/row-access). Dev and prod default: false. Turn it on only after
# the app is installed and its config is saved, then restart server and worker.
TWENTY_SPIRIT_ROW_ACCESS_ENFORCED=
# Email. Dev: leave empty; the emails print in the logs (LOGGER driver). Prod always sends with
# SMTP, and requires the host, port, user, and sender address. The password is
# TWENTY_EMAIL_SMTP_PASSWORD above.
TWENTY_EMAIL_FROM_NAME=
TWENTY_EMAIL_FROM_ADDRESS=
TWENTY_EMAIL_SMTP_HOST=
TWENTY_EMAIL_SMTP_PORT=
TWENTY_EMAIL_SMTP_USER=
# Prod required: the bucket's S3 endpoint, region, and name. Dev keeps uploads on a
# local volume. The keys are above.
TWENTY_STORAGE_S3_ENDPOINT=
TWENTY_STORAGE_S3_REGION=
TWENTY_STORAGE_S3_NAME=

# ---------------------------------------------------------------------------------------------
# PostgreSQL server for Chatwoot and Twenty (postgres/). Compose passes it to the container under
# the name after POSTGRES_SERVER_.
# ---------------------------------------------------------------------------------------------

# The superuser's password. The apps use their own roles, from their URLs above. Dev: leave empty
# for "postgres". Prod: generated.
POSTGRES_SERVER_SUPERUSER_PASSWORD=

# Prod: backups with pgBackRest to an S3 bucket. Leave POSTGRES_SERVER_S3_ENDPOINT empty to turn
# backups off. Backblaze B2: the endpoint is the bucket's S3 host without https://, such as
# s3.us-west-004.backblazeb2.com, and the region is its middle part, such as us-west-004. The key
# needs read and write on this one bucket.
POSTGRES_SERVER_S3_ENDPOINT=
POSTGRES_SERVER_S3_BUCKET=
POSTGRES_SERVER_S3_REGION=
POSTGRES_SERVER_S3_KEY=
POSTGRES_SERVER_S3_KEY_SECRET=
# Generated. Encrypts every backup. Keep a copy outside the server: without it, no backup can be
# restored. Never change it; the backups already made keep the old one.
POSTGRES_SERVER_BACKUP_CIPHER_PASS=

# ---------------------------------------------------------------------------------------------
# Cloudflare Tunnel. Zero Trust > Networks > Tunnels > your tunnel > the install command: the
# long string after --token. Anyone with it can serve traffic for your hostnames.
# ---------------------------------------------------------------------------------------------

CLOUDFLARE_TUNNEL_TOKEN=
