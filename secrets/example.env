# Every secret of every app, one file per environment: secrets/dev.env and secrets/prod.env.
# `just secrets init dev` (or prod) copies this file and fills the values it can generate.
# `just secrets tidy dev` (or prod) puts an existing file back in this layout.
# Both files are git-ignored. Keep a copy of prod.env in the password manager.
#
# Format: KEY=value on one line. No quotes, no spaces around =, no `export`. Docker Compose and
# `just spirit run` read the file as it is, so a quote would become part of the value. That is
# why a note about a key is on the line above it, never after the =.
#
# The note above a key says who fills it:
#   generated        `just secrets init` makes it.
#   you fill         you paste it in.
#   written by setup a setup recipe (such as `just chatwoot setup`) writes it.
# and, where it applies: dev only, prod only, optional, required in prod.
# An empty setting takes its local default in dev. Prod has none.

# =============================================================================================
# 1. SPIRIT AI (Fly)
# The names are the ones the app reads: AgentCore secrets in capitals, .NET settings with __
# between section and key. `just spirit run` loads dev.env; `just secrets push` sends prod.env
# to GitHub, and the "Sync Fly secrets" workflow copies it to Fly.
# =============================================================================================

# --- Models and search ---
# you fill
OPENAI_API_KEY=
# you fill
OPENCODE_GO_API_KEY=
# you fill
QDRANT_API_KEY=

# --- Database ---
# you fill. Dev: `just spirit run` points Spirit at a throwaway local database and ignores this.
POSTGRES_CONNECTION_STRING=

# --- Sage ---
# you fill. The Sage login the customer-service tools use.
CUSTSERVICE_SQL_PASSWORD=

# --- Observability ---
# you fill. Optional, together with the API token.
GRAFANA_CLOUD_INSTANCE_ID=
# you fill. Optional, together with the instance ID.
GRAFANA_CLOUD_API_TOKEN=

# --- Blob storage ---
# you fill. Prod only: the blob bucket. Dev uses the local MinIO.
AWS_ACCESS_KEY_ID=
# you fill. Prod only.
AWS_SECRET_ACCESS_KEY=

# --- Network and deploy ---
# you fill. Prod only: joins the Fly Machine to the tailnet. Starts with tskey-auth-.
TS_AUTHKEY=
# you fill. Prod only: lets the GitHub workflows deploy to Fly.
FLY_API_TOKEN=

# --- Sign-in ---
# you fill. Dev only. Prod has it in fly.toml.
Auth__Neon__BaseUrl=

# --- Chatwoot link ---
# `just chatwoot setup` writes Chatwoot__InboxIdentifier and Chatwoot__BotToken. You fill the
# other three (BaseUrl, AccountId, ServiceToken).
# you fill
Chatwoot__BaseUrl=http://localhost:53000
# you fill
Chatwoot__AccountId=
# written by setup
Chatwoot__InboxIdentifier=
# written by setup
Chatwoot__BotToken=
# you fill. A plain agent's access token. See chatwoot/setup/spirit-inbox.sh.
Chatwoot__ServiceToken=
# written by setup (`just chatwoot setup`)
Chatwoot__PlatformToken=
# written by setup (`just chatwoot setup`)
Chatwoot__AdminToken=
# written by setup (`just chatwoot setup`)
Chatwoot__InboxId=

# --- GoTo alerts ---
# Ring alerts. Optional, all five together. The PAT needs call-events.v1.events.read,
# call-events.v1.notifications.manage, users.v1.lines.read and identity:.
# you fill
Goto__ClientId=
# you fill
Goto__ClientSecret=
# you fill
Goto__PersonalAccessToken=
# you fill
Goto__AccountKey=
# generated. A long random value.
Goto__WebhookSecret=

# --- Hub ---
# Where the Hub is served and where its apps live. Dev only; prod has them in fly.toml. The
# ports are the local Chatwoot and Twenty (CHATWOOT_HOST_PORT and TWENTY_HOST_PORT below).
# you fill. Dev only.
Hub__Host=
# you fill. Dev only.
Hub__DeskUrl=http://desk.spirit.localhost:53000
# you fill. Dev only.
Hub__CrmUrl=http://crm.spirit.localhost:53001

# --- Twenty link ---
# How Spirit reaches the Twenty fork's endpoints.
# you fill
Twenty__BaseUrl=http://localhost:53001
# you fill. Must equal TWENTY_SPIRIT_HUB_SECRET below; `openssl rand -hex 32` makes one.
Twenty__HubSecret=

# =============================================================================================
# 2. POSTGRES SERVER (postgres/)
# One server for Chatwoot and Twenty. Compose passes each key to the container under the name
# after POSTGRES_SERVER_.
# =============================================================================================

# --- Superuser ---
# The apps use their own roles, from CHATWOOT_DATABASE_URL and TWENTY_PG_DATABASE_URL.
# generated in prod. Dev: leave empty for "postgres".
POSTGRES_SERVER_SUPERUSER_PASSWORD=

# --- Backups ---
# pgBackRest to an S3 bucket. Prod only. Leave POSTGRES_SERVER_S3_ENDPOINT empty to turn backups
# off. Backblaze B2: the endpoint is the bucket's S3 host without https://, such as
# s3.us-west-004.backblazeb2.com, and the region is its middle part, such as us-west-004. (The
# apps' endpoints below do take https://.) The key needs read and write on this one bucket.
# you fill
POSTGRES_SERVER_S3_ENDPOINT=
# you fill
POSTGRES_SERVER_S3_BUCKET=
# you fill
POSTGRES_SERVER_S3_REGION=
# you fill
POSTGRES_SERVER_S3_KEY=
# you fill
POSTGRES_SERVER_S3_KEY_SECRET=
# generated in prod. Encrypts every backup. Keep a copy outside the server: without it, no backup
# can be restored. Never change it; the backups already made keep the old one.
POSTGRES_SERVER_BACKUP_CIPHER_PASS=

# =============================================================================================
# 3. CHATWOOT (Desk)
# Compose passes each key to the container under the name after CHATWOOT_. Secrets and settings
# alike. A setting left empty takes its local default in dev; prod has none and will not start
# until every required one is set.
# =============================================================================================

# --- Address and ports ---
# Dev: leave empty for 53000. The port on this machine; prod has none.
CHATWOOT_HOST_PORT=
# Dev: leave empty for 58025. Where Mailpit shows the emails Chatwoot sent; prod has no Mailpit.
CHATWOOT_MAILPIT_PORT=
# Dev: leave empty for http://desk.spirit.localhost:53000. Required in prod:
# https://desk.<domain>.
CHATWOOT_FRONTEND_URL=
# Dev: leave empty for false. Prod: the tunnel ends TLS, so false is right there too.
CHATWOOT_FORCE_SSL=

# --- Rails core ---
# generated
CHATWOOT_SECRET_KEY_BASE=
# Default in dev and prod: redis://redis:6379. The password is CHATWOOT_REDIS_PASSWORD.
CHATWOOT_REDIS_URL=
# generated
CHATWOOT_REDIS_PASSWORD=
# generated in prod. Chatwoot's role, password, and database on the shared server in postgres/.
# Dev: leave empty for postgres://chatwoot:chatwoot@postgres:5432/chatwoot.
CHATWOOT_DATABASE_URL=
# Default in dev and prod: false.
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=
# Default in dev and prod: false.
CHATWOOT_SAFE_FETCH_ALLOW_PRIVATE_NETWORK=
# Default in dev and prod: true.
CHATWOOT_RAILS_LOG_TO_STDOUT=
# Default in dev and prod: info.
CHATWOOT_LOG_LEVEL=

# --- Hub sign-in ---
# initializers/spirit_hub.rb
# Dev: leave empty for http://hub.spirit.localhost:5299. Required in prod: https://hub.<domain>.
CHATWOOT_SPIRIT_HUB_ORIGIN=
# Dev: leave empty for http://hub.spirit.localhost:5299/chat/login.html?app=desk. Required in
# prod: https://hub.<domain>/chat/login.html?app=desk.
CHATWOOT_SPIRIT_HUB_LOGIN_URL=
# Where Chatwoot sends a visitor after sign-out. Same address as the login URL above, with the
# same dev default and prod requirement.
CHATWOOT_LOGOUT_REDIRECT_LINK=

# --- Email ---
# Dev: leave empty to use Mailpit (mailpit, 1025, localhost, no STARTTLS). Required in prod: the
# sender, host, port, domain, and STARTTLS (true or false).
# Dev: leave empty for Spirit <support@localhost>. Required in prod, such as
# Spirit <support@<domain>>.
CHATWOOT_MAILER_SENDER_EMAIL=
CHATWOOT_SMTP_ADDRESS=
CHATWOOT_SMTP_PORT=
CHATWOOT_SMTP_DOMAIN=
CHATWOOT_SMTP_ENABLE_STARTTLS_AUTO=
# Prod, when the server needs a login. AUTHENTICATION is the method (plain or login), not a key.
CHATWOOT_SMTP_USERNAME=
# you fill. Prod: the Resend API key when the CHATWOOT_SMTP_* keys point at Resend.
CHATWOOT_SMTP_PASSWORD=
CHATWOOT_SMTP_AUTHENTICATION=

# --- Uploads bucket ---
# Required in prod: the bucket's S3 endpoint (with https://), region, and name. Dev keeps uploads
# on a local volume.
CHATWOOT_STORAGE_ENDPOINT=
CHATWOOT_STORAGE_REGION=
CHATWOOT_STORAGE_BUCKET_NAME=
# you fill. Prod: an application key with read and write on the one bucket.
CHATWOOT_STORAGE_ACCESS_KEY_ID=
# you fill. Prod.
CHATWOOT_STORAGE_SECRET_ACCESS_KEY=

# --- Admin and setup tokens ---
# you fill. An administrator's access token (Profile settings > Access token), for
# `just chatwoot setup`.
CHATWOOT_ADMIN_TOKEN=

# =============================================================================================
# 4. TWENTY (CRM)
# Compose passes each key to the container under the name after TWENTY_. Secrets and settings
# alike. A setting left empty takes its local default in dev; prod has none and will not start
# until every required one is set.
# =============================================================================================

# --- Address and ports ---
# Dev: leave empty for 53001. The port on this machine; prod has none.
TWENTY_HOST_PORT=
# Dev: leave empty for http://crm.spirit.localhost:53001 (not localhost: the Hub frames the CRM
# and the session cookie needs both under spirit.localhost). Required in prod: https://crm.<domain>.
TWENTY_SERVER_URL=

# --- Core ---
# generated. Never change it after the first start; to rotate, move the old key to
# TWENTY_FALLBACK_ENCRYPTION_KEY first.
TWENTY_ENCRYPTION_KEY=
# you fill. Only when rotating: the old encryption key.
TWENTY_FALLBACK_ENCRYPTION_KEY=
# generated. Letters and digits only: it goes in the redis URL.
TWENTY_REDIS_PASSWORD=
# generated in prod. Twenty's role, password, and database on the shared server in postgres/.
# Dev: leave empty for postgres://twenty:twenty@postgres:5432/twenty.
TWENTY_PG_DATABASE_URL=
# Default in dev and prod: false.
TWENTY_TELEMETRY_ENABLED=

# --- Row access ---
# Owner row access (twenty/apps/row-access).
# Default in dev and prod: false. Turn it on only after the app is installed and its config is
# saved, then restart server and worker.
TWENTY_SPIRIT_ROW_ACCESS_ENFORCED=

# --- Hub sign-in ---
# you fill. Must equal Twenty__HubSecret above.
TWENTY_SPIRIT_HUB_SECRET=
# Dev: leave empty for http://hub.spirit.localhost:5299. Required in prod: https://hub.<domain>.
TWENTY_SPIRIT_HUB_ORIGIN=
# Dev: leave empty for http://hub.spirit.localhost:5299/chat/login.html?app=crm. Required in
# prod: https://hub.<domain>/chat/login.html?app=crm.
TWENTY_SPIRIT_HUB_LOGIN_URL=

# --- Email ---
# Dev: leave empty; the emails print in the logs (LOGGER driver). Prod always sends with SMTP,
# and requires the host, port, user, and sender address.
TWENTY_EMAIL_FROM_NAME=
TWENTY_EMAIL_FROM_ADDRESS=
TWENTY_EMAIL_SMTP_HOST=
TWENTY_EMAIL_SMTP_PORT=
TWENTY_EMAIL_SMTP_USER=
# you fill. Required in prod.
TWENTY_EMAIL_SMTP_PASSWORD=

# --- Uploads bucket ---
# Required in prod: the bucket's S3 endpoint (with https://), region, and name. Dev keeps uploads
# on a local volume.
TWENTY_STORAGE_S3_ENDPOINT=
TWENTY_STORAGE_S3_REGION=
TWENTY_STORAGE_S3_NAME=
# you fill. Prod.
TWENTY_STORAGE_S3_ACCESS_KEY_ID=
# you fill. Prod.
TWENTY_STORAGE_S3_SECRET_ACCESS_KEY=

# --- Microsoft sign-in ---
# you fill. Optional.
TWENTY_AUTH_MICROSOFT_CLIENT_SECRET=

# =============================================================================================
# 5. CLOUDFLARE TUNNEL (cloudflared/)
# =============================================================================================

# you fill. Prod only. Zero Trust > Networks > Tunnels > your tunnel > the install command: the
# long string after --token. Anyone with it can serve traffic for your hostnames.
CLOUDFLARE_TUNNEL_TOKEN=
