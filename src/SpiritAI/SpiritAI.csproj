<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>61731f03-519d-4c62-84f0-ad54e7b0f0c3</UserSecretsId>
  </PropertyGroup>

  <!--
    Switchable AgentCore reference — see Directory.Build.props. Local checkout by default for the
    fast edit/F5 loop; the NuGet package when UseLocalAgentCore=false (CI).
  -->
  <ItemGroup Condition="'$(UseLocalAgentCore)' == 'true'">
    <ProjectReference Include="$(AgentCoreRoot)/src/AgentCore.Hosting/AgentCore.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalAgentCore)' != 'true'">
    <PackageReference Include="AgentCore.Hosting" Version="0.3.0" />
  </ItemGroup>

  <!--
    Match AgentCore's pin (Directory.Packages.props there). Without this, NuGet resolves an older
    transitive Microsoft.Extensions.AI here and every build warns about an assembly conflict.
    Bump alongside AgentCore.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config/spirit.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ClientAppSource Include="../web/src/**/*" />
    <ClientAppSource Include="../web/index.html" />
    <ClientAppSource Include="../web/package.json" />
    <ClientAppSource Include="../web/package-lock.json" />
    <ClientAppSource Include="../web/vite.config.ts" />
    <ClientAppSource Include="../web/tsconfig*.json" />
  </ItemGroup>

  <!--
    Same pattern as the AgentCore demo: Node is required, not probed for, and Outputs names the
    real Vite artifact (not a stamp) so a deleted wwwroot forces a rebuild instead of a silent 404.
    Set SkipClientAppBuild=true for a server-only build on a machine without Node.
  -->
  <Target Name="BuildClientApp" BeforeTargets="BeforeBuild" Condition="'$(SkipClientAppBuild)' != 'true'" Inputs="@(ClientAppSource)" Outputs="wwwroot/chat/index.html">
    <Exec Command="npm ci" WorkingDirectory="../web" />
    <Exec Command="npm run build" WorkingDirectory="../web" />
  </Target>

</Project>
