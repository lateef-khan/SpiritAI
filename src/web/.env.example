# The Neon Auth base URL for this project. Copy this file to .env and fill it in.
#
# Neon Console → your project → Auth → Configuration → Auth Base URL. It looks like:
#   https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
#
# Public by design: the browser posts to it, and Vite bakes every VITE_ variable into the bundle.
# Do not put a secret key here.
VITE_NEON_AUTH_URL=
