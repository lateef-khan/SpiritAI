# Copy to chatwoot/.env with `just env` (or `just chatwoot env` from the repo root), which also fills SECRET_KEY_BASE.
# Full list of settings: https://github.com/chatwoot/chatwoot/blob/v4.18.0/.env.example

SECRET_KEY_BASE=
CHATWOOT_PORT=53000
FRONTEND_URL=http://localhost:53000
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false

# Empty: a throwaway local postgres. Neon: the DIRECT host (no -pooler), and the chatwoot
# schema must exist first (create schema chatwoot;).
# DATABASE_URL=postgres://USER:PASS@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&schema_search_path=chatwoot,public
DATABASE_URL=

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=chatwoot

MAILPIT_PORT=58025
MAILER_SENDER_EMAIL=Spirit <support@localhost>
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_ENABLE_STARTTLS_AUTO=false
# Production with Resend (the password is a Resend API key; the sender domain must be verified in Resend):
# MAILER_SENDER_EMAIL=Spirit <support@your-domain.com>
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_DOMAIN=your-domain.com
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxx
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# Local dev keeps uploads on a throwaway volume. Production ignores this line and needs the
# STORAGE_* bucket below. Backblaze B2: the endpoint and region are on the bucket page, and
# the keys are an application key with read and write on that one bucket.
ACTIVE_STORAGE_SERVICE=local
# STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# STORAGE_REGION=us-west-004
# STORAGE_BUCKET_NAME=spirit-chatwoot
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Chatwoot refuses to call a private address (SSRF guard). Local dev calls Spirit on the host
# through host.docker.internal, so it needs true. Production: false while Spirit's webhook URL
# is public HTTPS.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# Read only by `just setup`, never by Chatwoot. SPIRIT_WEBHOOK_URL is Spirit's /chatwoot/webhook.
# CHATWOOT_ADMIN_TOKEN=
# CHATWOOT_ACCOUNT_ID=
# SPIRIT_WEBHOOK_URL=http://host.docker.internal:5299/chatwoot/webhook

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
