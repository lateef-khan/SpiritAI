CHATWOOT_PORT=53000
FRONTEND_URL=http://desk.spirit.localhost:53000
FORCE_SSL=false
# initializers/spirit_hub.rb: the Hub's origin, and where a signed-out visit to /app/login goes.
SPIRIT_HUB_ORIGIN=http://hub.spirit.localhost:5299
SPIRIT_HUB_LOGIN_URL=http://hub.spirit.localhost:5299/chat/login.html?app=desk
# Chatwoot's own setting: where it sends a visitor after they sign out of the dashboard.
LOGOUT_REDIRECT_LINK=http://hub.spirit.localhost:5299/chat/login.html?app=desk
ENABLE_ACCOUNT_SIGNUP=false
REDIS_URL=redis://redis:6379
MAILPIT_PORT=58025
MAILER_SENDER_EMAIL=Spirit <support@localhost>
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_ENABLE_STARTTLS_AUTO=false
ACTIVE_STORAGE_SERVICE=local
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
