# Chatwoot recipes. From the repo root: `just chatwoot <recipe>`. On the server: `just <recipe>`
# inside this folder. Recipes run here either way.
#
# Local dev and production use different compose projects, so `down` can never touch the
# production volumes.

dev := "docker compose --file compose.yaml"
prod := "docker compose --file compose.yaml --file compose.prod.yaml"

# List the recipes.
default:
    @just --list

# Make .env from .env.example, with a fresh SECRET_KEY_BASE. Never overwrites.
env:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f .env ]; then
        echo "chatwoot/.env already exists; leaving it alone."
        exit 0
    fi
    sed "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$(openssl rand -hex 64)|" .env.example > .env
    echo "Wrote chatwoot/.env."

# Local dev: start and wait. With DATABASE_URL empty, a throwaway postgres starts too.
up: env _edge
    #!/usr/bin/env bash
    set -euo pipefail
    profile=()
    if ! grep -qE '^DATABASE_URL=.+' .env; then
        profile=(--profile localdb)
        echo "DATABASE_URL is empty: starting a throwaway local postgres."
    fi
    {{dev}} "${profile[@]}" up --detach --build
    just _wait "{{dev}}"
    echo "Chatwoot is ready on http://localhost:$(grep -oP '^CHATWOOT_PORT=\K.+' .env || echo 53000)."

# Local dev: stop and delete everything local (postgres, redis, uploads). A remote database is untouched.
down:
    {{dev}} --profile localdb down --volumes

# Local dev: follow the logs.
logs:
    {{dev}} --profile localdb logs --follow --tail=100

# Local dev: open a Rails console.
console:
    {{dev}} exec web bundle exec rails console

# Make or update the Spirit API inbox and agent bot, and print Spirit's settings. See setup/spirit-inbox.sh.
setup:
    ./setup/spirit-inbox.sh

# Prove the public contact routes drop email and phone (initializers/spirit_public_contact_guard.rb).
# Makes one throwaway contact. The inbox identifier is the one `just setup` prints.
check-contact-guard inbox_identifier url="http://localhost:53000":
    #!/usr/bin/env bash
    set -euo pipefail
    contacts="{{url}}/public/api/v1/inboxes/{{inbox_identifier}}/contacts"
    key="contact-guard-check-$(date +%s)"
    fields='{"email":"contact-guard-check@example.com","phone_number":"+13125550100"}'
    created="$(curl --silent --fail-with-body --header 'Content-Type: application/json' \
        --data "$(jq -c --arg key "$key" '. + {source_id: $key}' <<<"$fields")" "$contacts")"
    updated="$(curl --silent --fail-with-body --request PATCH --header 'Content-Type: application/json' \
        --data "$fields" "$contacts/$key")"
    for answer in "$created" "$updated"; do
        if [ "$(jq -r '.email // empty, .phone_number // empty' <<<"$answer")" != "" ]; then
            echo "FAIL: Chatwoot kept an email or phone from the public API: $answer" >&2
            exit 1
        fi
    done
    echo "OK: the public contact routes dropped email and phone."

# Production: first start, or start after prod-down. Needs DATABASE_URL in .env.
prod-up: _edge
    {{prod}} up --detach --build
    just _wait "{{prod}}"

# Production: rebuild, migrate, and restart web and worker only. Redis keeps running.
prod-update: _edge
    {{prod}} up --detach --build migrate web worker
    just _wait "{{prod}}"

# Production: stop everything. Keeps the redis and upload volumes.
prod-down:
    {{prod}} down

# Production: show the containers.
prod-status:
    {{prod}} ps

# Production: follow the logs.
prod-logs:
    {{prod}} logs --follow --tail=100

# Production: open a Rails console.
prod-console:
    {{prod}} exec web bundle exec rails console

# The network the tunnel shares with every app.
_edge:
    @docker network inspect spirit-edge >/dev/null 2>&1 || docker network create spirit-edge

# Asks web from inside its container, because production has no port on the host.
_wait compose:
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 180); do
        if {{compose}} exec -T web wget -q -O /dev/null http://127.0.0.1:3000/api >/dev/null 2>&1; then
            echo "Chatwoot is ready."
            exit 0
        fi
        sleep 1
    done
    echo "Chatwoot never answered. Try the logs recipe." >&2
    exit 1
